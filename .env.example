# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Required for Stripe webhooks (Dashboard → Settings → API → service_role; keep secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: override free-plan item cap (default 10). Enforced in createItem.
# FREE_ITEM_LIMIT=10

# --- Stripe (Phase 2 — test mode) ---
# Dashboard → Developers → API keys (Test mode toggle ON)
STRIPE_SECRET_KEY=sk_test_...
# Optional: only needed if you add Stripe.js / Elements later (Checkout redirect does not require it)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# One-time $5 Price id (see README “Create a $5 one-time Price”)
STRIPE_PRICE_ID=price_...

# Webhook signing secret — from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (or Dashboard → Developers → Webhooks → endpoint signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: public origin for Checkout success/cancel URLs (defaults to http://localhost:3000;
# on Vercel, falls back to https://$VERCEL_URL)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
